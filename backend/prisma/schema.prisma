// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  role         String?
  refreshToken String?  
  createdAt    DateTime @default(now())

  cart      Cart?
  orders    Order[]
  addresses Address[] // <-- EKLENDİ: Kullanıcının adres ilişkisi
}

// EKLENDİ: E-ticaret sipariş adresleri için Address modeli
model Address {
  id        Int      @id @default(autoincrement())
  title     String   // Örn: "Ev", "İş"
  city      String
  district  String
  detail    String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  products Product[]
}

enum Gender {
  ERKEK
  KADIN
  UNISEX
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Decimal
  stock       Int
  images      String[]
  gender      Gender

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  cartItems CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())

  cart   Cart @relation(fields: [cartId], references: [id])
  cartId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  quantity Int

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model Order {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  status    OrderStatus @default(PENDING)
  total     Decimal
  createdAt DateTime    @default(now())

  orderItems OrderItem[]
}

model OrderItem {
  id Int @id @default(autoincrement())

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  quantity        Int
  priceAtPurchase Decimal
}