// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  role         String?
  refreshToken String?  
  createdAt    DateTime @default(now())

  cart      Cart?
  orders    Order[]
  addresses Address[] 
  favorites Favorite[]
}


model Address {
  id        Int      @id @default(autoincrement())
  title     String   // Örn: "Ev", "İş"
  city      String
  district  String
  detail    String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  products Product[]
}

enum Gender {
  ERKEK
  KADIN
  UNISEX
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Decimal  @default(0)
  stock       Int      @default(0)
  gender      Gender
  series      String?  // "Signature" / "Horizon" / "Apex"

  styleTags String[]

  // Ürün sayfasında gösterilecek teknik özellikler
  caseSize        String? // Model Kasası
  material        String? // Malzeme
  bezel           String? // Çerçeve
  crown           String? // Kurma Kolu
  crystal         String? // Kristal
  waterResistance String? // Su Geçirmezlik
  movement        String? // Mekanizma
  strap           String? // Bilezik / Kayış
  dial            String? // Kadran

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  variants   ProductVariant[]
  orderItems OrderItem[]
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  colorName String   
  colorHex  String   
  images    String[]
  price     Decimal  @default(0)
  stock     Int      @default(0)
  discount  Int      @default(0) 

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  favorites Favorite[]
  cartItems CartItem[]
}


model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId Int

  @@unique([userId, variantId])
}

model Cart {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  cartItems CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())

  cart   Cart @relation(fields: [cartId], references: [id])
  cartId Int


  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId Int

  quantity Int

  @@unique([cartId, variantId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model Order {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  status    OrderStatus @default(PENDING)
  total     Decimal
  createdAt DateTime    @default(now())

  orderItems OrderItem[]
}

model OrderItem {
  id Int @id @default(autoincrement())

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  quantity        Int
  priceAtPurchase Decimal
}