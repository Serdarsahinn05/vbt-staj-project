# Copy this file to .env: `cp .env.example .env`
#
# When running via `docker compose up`, the api container already gets its
# own DATABASE_URL (pointing at the postgres service) from docker-compose.yml.
# The value below is only used when you run the app or `npx prisma ...`
# commands directly on your host machine, against the Postgres container
# exposed on localhost:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"
PORT=3000
